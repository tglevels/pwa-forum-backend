PORT=3005
DB_HOST=127.0.0.1
DB_USER=tg_level
DB_PASS=tg_level@123
DB_NAME=tg_level
NODE_ENV=production

# Same secret pwa-node-backend uses to sign RA JWTs — verified statelessly here,
# no network call back to pwa-node-backend needed.
JWT_SECRET=bf20c11475b79a87073bc8bfa51107fe71cd99adfa8089734aaaf986969ff32e
RA_ADMIN_PHONE=9999999999

# Separate secret for end-user forum tokens minted by tglevel_mobile_pwa's
# server-side session route — deliberately different from JWT_SECRET so a
# leaked user token can never be mistaken for an RA token.
FORUM_JWT_SECRET=64f78ffbd73b4b559bb327d7e66f7b01f54a40a9d105f4f75fb616cacd5bafe1

# PWA_NOTIFY peer service — fire-and-forget push 4 v, same pattern
# pwa-node-backend already uses.
PWA_NOTIFY_URL=http://localhost:3001
